# Copia este archivo a .env y ajusta los valores. .env NO se sube al repositorio.

# --- Origen: ArcGIS FeatureServer público (sin token) ---
ARCGIS_LAYER_URL=https://services2.arcgis.com/C8EMgrsFcRFL6LrL/arcgis/rest/services/CONAMP_Federal_Protected_Areas_in_Mexico_2026/FeatureServer/1
# Filtro SQL de ArcGIS. Ejemplo solo Península:
# ARCGIS_WHERE=ESTADOS LIKE '%Yucat%' OR ESTADOS LIKE '%Campeche%' OR ESTADOS LIKE '%Quintana%'
ARCGIS_WHERE=1=1
ARCGIS_PAGE_SIZE=50
ARCGIS_TIMEOUT=60
DATASET_NAME=anp_conanp_2026

# --- Validación y mapa ---
PENINSULA_STATES=Campeche,Quintana Roo,Yucatán
AREA_TOLERANCE_PCT=10
WEB_SIMPLIFY_TOLERANCE_M=150

# --- PostGIS (los usa docker-compose.yml y el pipeline) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=geodata
POSTGRES_USER=gis
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_SCHEMA=conanp
POSTGRES_TABLE=anp_federales

# --- Análisis: ejidos (RAN) + Google Earth Engine ---
# ID del proyecto de Google Cloud registrado para Earth Engine (después: earthengine authenticate)
EE_PROJECT=tu-proyecto-ee
# Estados (códigos de los archivos del RAN): camp, tab, qroo, yuc, chis, ver
STATES=camp,tab
YEARS=2015-2024
# Hansen GFC: dosel mínimo en 2000 para considerar "bosque" (%)
TREECOVER_THRESHOLD=30
HANSEN_ASSET=UMD/hansen/global_forest_change_2025_v1_13
# Sensibilidad: dilatación del área quemada MCD64A1 (m). 0 la desactiva.
FIRE_BUFFER_SENS_M=500
FIRMS_MIN_CONFIDENCE=50
# Ejidos por solicitud y solicitudes simultáneas a Earth Engine
GEE_BATCH_SIZE=5
GEE_WORKERS=2
# Traslapes entre ejidos menores a esto (ha) se consideran astillas de digitalización
OVERLAP_MIN_HA=1
